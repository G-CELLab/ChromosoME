      m_Calls: []
  m_text: 'Interphase:

    You are now in the phase of growth for the cell where
    specialized cellular functions occur in order to prepare the cell for DNA Replication.
    Mitochondria consume nutrition and generate the majority of our adenosine triphosphate
    (ATP), the energy currency of the cell.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
